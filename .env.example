# Offline demonstration is enabled by default; no model or credentials needed.
LLM_ENABLED=false

# Optional: configure a local OpenAI-compatible model server.
LLM_PROVIDER=ollama
LLM_API_KEY=ollama
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:7b

# For a remote provider, set its URL, model and your own key in a local .env.
# Do not commit your .env or any real credentials.
